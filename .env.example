# Optional ModelScope OpenAPI token for the separate skill marketplace during
# local development. The GGUF model marketplace never reads these values; its
# metadata access is confined to the Cloudflare catalog below.
MODELSCOPE_API_TOKEN=

# Optional token pool. Separate multiple tokens with commas.
# MODELSCOPE_API_TOKENS=token_1,token_2,token_3

# Optional emergency override for the built-in Agent web-search credential.
# Normal releases include an obfuscated main-process value; use this only for
# token rotation before the next desktop build. Never expose it to renderer code
# or user settings, and never commit a real value.
ZHIYUAN_ANYSEARCH_GATEWAY_TOKEN=
ZHIYUAN_ANYSEARCH_GATEWAY_URL=https://search.rongxzyai.com

# GGUF model catalog boundary. Desktop clients never call ModelScope OpenAPI
# directly; if the catalog is unavailable, only bundled browse-only entries are
# shown and installation remains gated on verified catalog metadata.
ZHIYUAN_MODEL_CATALOG_URL=https://models.rongxzyai.com
