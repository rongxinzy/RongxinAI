    "setup:python-runtime": "node scripts/setup-python-runtime.js",
    "setup:uv-runtime": "node scripts/setup-uv-runtime.js",
    "setup:posix-uv-runtime": "node scripts/setup-mac-uv-runtime.js",
    "setup:posix-python-runtime": "node scripts/setup-mac-python-runtime.js",
    "setup:skill-python-runtime": "node scripts/setup-skill-python-runtime.js",
    "validate:skills": "node scripts/validate-skill-frontmatter.cjs",
    "channel:runtime:host": "node scripts/channel-runtime-host.cjs",
    "channel:runtime:download": "node scripts/download-channel-runtime.cjs",
    "channel:runtime:mac-x64": "node scripts/download-channel-runtime.cjs mac-x64",
    "channel:runtime:mac-arm64": "node scripts/download-channel-runtime.cjs mac-arm64",
    "channel:runtime:mac-universal": "node scripts/download-channel-runtime.cjs mac-x64 && node scripts/download-channel-runtime.cjs mac-arm64",
    "channel:runtime:win-x64": "node scripts/download-channel-runtime.cjs win-x64",
    "channel:runtime:linux-x64": "node scripts/download-channel-runtime.cjs linux-x64",
    "channel:runtime:smoke": "node scripts/channel-runtime-smoke.cjs",
    "engram:runtime:host": "node scripts/download-engram-runtime.cjs",
