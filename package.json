    "engram:runtime:mac-arm64": "node scripts/download-engram-runtime.cjs mac-arm64",
    "engram:runtime:win-x64": "node scripts/download-engram-runtime.cjs win-x64",
    "engram:runtime:win-arm64": "node scripts/download-engram-runtime.cjs win-arm64",
    "engram:runtime:linux-x64": "node scripts/download-engram-runtime.cjs linux-x64",
    "engram:runtime:linux-arm64": "node scripts/download-engram-runtime.cjs linux-arm64",
    "llamacpp:runtime:host": "node scripts/llamacpp-runtime-host.cjs",
    "llamacpp:runtime:download": "node scripts/download-llamacpp-runtime.cjs",
    "llamacpp:runtime:download:mac-arm64": "node scripts/download-llamacpp-runtime.cjs mac-arm64",
    "llamacpp:runtime:download:mac-x64": "node scripts/download-llamacpp-runtime.cjs mac-x64",
    "llamacpp:runtime:download:win-x64": "node scripts/download-llamacpp-runtime.cjs win-x64",
    "llamacpp:runtime:download:win-x64-cuda-12": "node scripts/download-llamacpp-runtime.cjs win-x64-cuda-12",
    "llamacpp:runtime:download:linux-x64": "node scripts/download-llamacpp-runtime.cjs linux-x64",
    "llamacpp:runtime:download:linux-arm64": "node scripts/download-llamacpp-runtime.cjs linux-arm64",
    "llamacpp:runtime:mac-arm64": "node scripts/run-build-llamacpp-runtime.cjs mac-arm64 && node scripts/sync-llamacpp-runtime-current.cjs mac-arm64",
    "llamacpp:runtime:mac-x64": "node scripts/run-build-llamacpp-runtime.cjs mac-x64 && node scripts/sync-llamacpp-runtime-current.cjs mac-x64",
    "llamacpp:runtime:win-x64": "node scripts/run-build-llamacpp-runtime.cjs win-x64 && node scripts/sync-llamacpp-runtime-current.cjs win-x64",
    "llamacpp:runtime:linux-x64": "node scripts/run-build-llamacpp-runtime.cjs linux-x64 && node scripts/sync-llamacpp-runtime-current.cjs linux-x64",
    "llamacpp:runtime:linux-arm64": "node scripts/run-build-llamacpp-runtime.cjs linux-arm64 && node scripts/sync-llamacpp-runtime-current.cjs linux-arm64",
    "upload:artifact": "node scripts/upload-artifact.cjs",
    "regenerate:icon": "python3 scripts/generate-app-icons.py",
    "fix:mac-icon": "bash scripts/fix-mac-icon-display.sh",
    "check:electron-runtime-dependencies": "node scripts/ci/check-electron-runtime-dependencies.mjs",
    "theme:generate": "bun src/renderer/theme/scripts/generate-css.ts",
    "theme:check": "bun src/renderer/theme/scripts/generate-css.ts --check",
    "theme:audit": "bun src/renderer/theme/scripts/audit-styles.ts"
  },
