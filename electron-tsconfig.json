{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": false,
    "sourceMap": false,
    "rootDir": "./src",
    "outDir": "dist-electron",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/main", "src/common", "src/shared"],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    // Renderer-only chat UI; never imported by the main process. Excluding
    // it lets the renderer use extensionless dynamic imports that NodeNext
    // resolution would otherwise reject.
    "src/shared/components/ai-elements"
  ]
}
