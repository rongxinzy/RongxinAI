{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": false,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "dist-electron",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/main", "src/common", "src/shared"],
  "exclude": ["src/**/*.test.*", "src/**/*.spec.*"]
}
