{
  "workflows": [
    {
      "name": "Channel runtime smoke",
      "path": ".github/workflows/channel-runtime-smoke.yml",
      "branches": [
        "main"
      ]
    },
    {
      "name": "CI",
      "path": ".github/workflows/ci.yml",
      "branches": [
        "main"
      ]
    },
    {
      "name": "Installer visual review only",
      "path": ".github/workflows/installer-style-preview.yml",
      "paths": [
        "scripts/installer-shell/preview/**",
        "scripts/installer-shell/preview-ui.test.ts",
        "scripts/ci/installer-style-preview.py",
        ".github/workflows/installer-style-preview.yml"
      ]
    },
    {
      "name": "Windows installer gate",
      "path": ".github/workflows/windows-installer-pr.yml",
      "branches": [
        "fix/installer-language-acceptance"
      ],
      "paths": [
        "scripts/installer-shell/**",
        "scripts/ci/windows-shell-*",
        "scripts/ci/windows-installer-*",
        ".github/workflows/windows-installer-pr.yml"
      ]
    }
  ]
}
