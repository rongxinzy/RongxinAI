+    }
   }
   return {
     stop: async () => {
       for (const entry of running.toReversed()) {
         if (!entry.stop) continue;
         try {
           await entry.stop();
         } catch (err) {
           log.warn(`plugin service stop failed (${entry.id}): ${String(err)}`);
         }
       }
     },
   };
 }
