-      running.push({
-        id: service.id,
-        stop: service.stop ? () => service.stop?.(serviceContext) : void 0,
-      });
-    } catch (err) {
-      const error = err as Error;
-      const stack = error?.stack?.trim();
-      log.error(`plugin service failed (${service.id}, plugin=${entry.pluginId}, root=${entry.rootDir ?? "unknown"}): ${error?.message ?? String(err)}${stack ? `\n${stack}` : ""}`);
-    }
+  const results = await Promise.allSettled(
+    params.registry.services.map(async (entry) => {
+      const service = entry.service;
+      await service.start(serviceContext);
+      return { id: service.id, stop: service.stop, serviceContext };
+    }),
+  );
+  for (let i = 0; i < results.length; i++) {
+    const result = results[i];
+    if (result.status === "fulfilled") {
+      const { id, stop, serviceContext: ctx } = result.value;
+      running.push({
+        id,
+        stop: stop ? () => stop?.(ctx) : void 0,
+      });
+    } else {
