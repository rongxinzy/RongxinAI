 // LobsterAI patch (Phase 2 / O5): start plugin services in parallel.
 // Each service.start() is independent — they only read from the shared
 // config/workspaceDir context.
 async function startPluginServices(params: StartPluginServicesParams) {
   const running: RunningService[] = [];
   const serviceContext = createServiceContext({
     config: params.config,
     workspaceDir: params.workspaceDir,
   });
-  for (const entry of params.registry.services) {
