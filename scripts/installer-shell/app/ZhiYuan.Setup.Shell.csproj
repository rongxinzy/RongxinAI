<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ZhiYuan.Setup.Shell</RootNamespace>
    <AssemblyName>ZhiYuanSetupShell</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <Product>知远智能体 Setup Shell</Product>
    <Description>WebView2 shell for the ZhiYuan Agent installer UI</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- The packaged single file must render its UI without a sidecar ui/
         directory: the page and its two brand assets ship as embedded
         resources and are materialized next to the self-extracted payload. -->
    <EmbeddedResource Include="..\preview\index.html" LogicalName="ui.index.html" />
    <EmbeddedResource Include="..\..\..\public\zhiyuan-logo-light-1600.png" LogicalName="ui.assets.logo" />
    <EmbeddedResource Include="..\..\..\build\icons\png\256x256.png" LogicalName="ui.assets.icon" />
  </ItemGroup>

</Project>
